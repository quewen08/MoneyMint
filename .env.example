# FamBean 部署环境变量示例
#
# 用法：
#   cp .env.example .env
#   然后按需修改 .env（.env 已被 .gitignore 忽略，不会提交）

# ── 必改 ─────────────────────────────────────────────────────────────
# 镜像全名。把 your-dockerhub-user 换成你自己的 Docker Hub 用户名。
# 版本号建议固定（如 :0.5.0），跟随最新版可改 :latest。
FAMBEN_IMAGE=your-dockerhub-user/money-mint:0.5.0

# ── 按需修改 ─────────────────────────────────────────────────────────
# 主机端口（8080 被占用就换，比如 18080）
FAMBEN_PORT=8080

# 数据目录。NAS 上建议写绝对路径，例如 /volume1/docker/famben/data
# 属主由镜像入口脚本自动修正（启动时 chown 到 10001 后降权运行），无需手工处理
FAMBEN_DATA=./data

# 时区（影响交易日归属与备份触发时间）
TZ=Asia/Shanghai

# ── 备份策略 ─────────────────────────────────────────────────────────
# 每日自动备份触发小时（0-23）
LEDGER_BACKUP_HOUR=3
# 保留最近 N 份每日备份
LEDGER_BACKUP_KEEP_DAILY=14
# 保留最近 M 个月的每月一份
LEDGER_BACKUP_KEEP_MONTHLY=12

# 备份目录。留空 = 与数据库同盘（/app/data/backups）
# 若在 compose 里挂载了第二块盘（/backup），这里设为 /backup
LEDGER_BACKUP_DIR=
