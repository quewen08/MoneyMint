{
  "name": "fambean-web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "FamBean 家庭记账前端（Vue 3 + Vite 纯 SPA）",
  "engines": {
    "node": ">=22.22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "compat": "node scripts/compat.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-legacy": "^5.4.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "es-check": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
